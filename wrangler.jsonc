{
  // Cloudflare Workers Builds 가 `npx wrangler deploy` 로 읽는 설정.
  // main 이 없는 정적 자산 전용 워커다. 빌드가 만든 dist 를 그대로 올린다.
  "name": "oasisknot",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
